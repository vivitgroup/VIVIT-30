# ═══════════════════════════════════════════════════════════════
# VIVIT ERP — Complete Environment Variables
# Copy to .env and fill in your values
# Run: cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── REQUIRED — App will not start without these ───────────────
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_SERVICE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIn0..."
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_ID:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
AUTH_SECRET="your-32-plus-char-secret-here-change-this"
NEXTAUTH_URL="http://localhost:3000"

# ── VIVIT GROUP → MARKETING HANDOFF RECEIVER ─────────────────
# Keep disabled until the unified exact-head audit is green and the nonce migration is applied.
VGROUP_MARKETING_HANDOFF_RECEIVER_ENABLED="false"
# Must exactly match the unified production browser origin, with no trailing slash.
VGROUP_GROUP_ORIGIN=""
# Same dedicated >=32-byte value used by the Group runtime. Never reuse AUTH_SECRET or VGROUP_AUTH_SECRET.
VGROUP_MARKETING_HANDOFF_SECRET=""

# ── OPTIONAL — Features work without these but are limited ────
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
RESEND_API_KEY=""
OTP_FROM_EMAIL="VIVIT ERP <access@vivitgroup.com>"
EMAIL_FROM="Vivit ERP <noreply@yourdomain.com>"
# Generate a unique random secret; never reuse AUTH_SECRET or a shared example value.
CRON_SECRET=""
SLACK_WEBHOOK_URL=""

# ── PAYMENT GATEWAY ────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""

# ── WHATSAPP BUSINESS API (Meta Cloud API) ────────────────────
# Direct wa.me links work without API credentials.
# Sending from inside VIVIT requires a real Cloud API token + Phone Number ID.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_GRAPH_VERSION="v23.0"

# ── AD PLATFORM INTEGRATIONS ───────────────────────────────────
# Meta: supports direct Ad Account ID + Campaign ID sync.
META_ACCESS_TOKEN=""
META_GRAPH_VERSION="v23.0"
META_PIXEL_ID=""
META_CLIENT_ID=""
META_CLIENT_SECRET=""

# TikTok: supports direct Advertiser ID + Campaign ID sync.
TIKTOK_ACCESS_TOKEN=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""

SNAPCHAT_TOKEN=""
SNAPCHAT_ACCESS_TOKEN=""
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""

GOOGLE_ADS_ACCESS_TOKEN=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
GOOGLE_ADS_VERSION="v22"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GA4_MEASUREMENT_ID=""
GA4_API_SECRET=""

LINKEDIN_TOKEN=""
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_VERSION="202601"
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# REQUIRED for ad OAuth. Generate a dedicated 32+ character secret.
# Do not reuse AUTH_SECRET/NEXTAUTH_SECRET; changing this key invalidates stored OAuth tokens.
OAUTH_ENCRYPTION_KEY=""

# ── DRIZZLE ORM ────────────────────────────────────────────────
DRIZZLE_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres"
