# ═══════════════════════════════════════════════════════════════
# VIVIT ERP — Complete Environment Variables
# Copy to .env and fill in your values
# Run: cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── REQUIRED — App will not start without these ───────────────

# Supabase Project URL
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# Supabase service_role key (NOT the anon key — needs full access)
SUPABASE_SERVICE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIn0..."

# Database — MUST use Transaction Pooler on port 6543 (NOT 5432)
# Find in: Supabase → Settings → Database → Connection Pooling → Transaction
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_ID:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Auth secret — generate with: openssl rand -base64 32
# Must be 32+ characters
AUTH_SECRET="your-32-plus-char-secret-here-change-this"

# Your deployed URL — must match exactly (no trailing slash)
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── OPTIONAL — Features work without these but are limited ────

# Anthropic Claude — enables all 5 AI Studio tools
# Get from: console.anthropic.com
ANTHROPIC_API_KEY=""

# Resend — enables email notifications, approvals, digests
# Free tier: 3,000 emails/month — resend.com
RESEND_API_KEY=""

# Sender email address (must be verified in Resend)
EMAIL_FROM="Vivit ERP <noreply@yourdomain.com>"

# Cron secret — protects /api/cron from public access
# Any random string works
CRON_SECRET="vivit-cron-secret-2025"

# Slack webhook — enables Slack alerts for budget, churn, invoices
# Create at: api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=""

# ── PAYMENT GATEWAY (enables online invoice payment) ──────────

# Stripe — global payment processing
# Get from: dashboard.stripe.com → API Keys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Paymob — MENA payment gateway (Egypt, Saudi, UAE)
# Get from: accept.paymob.com → Settings → API Keys
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""

# ── WHATSAPP BUSINESS API (Meta Cloud API) ────────────────────

# Create at: developers.facebook.com → WhatsApp → Getting Started
# Without these, WhatsApp runs in simulation mode (logs only)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# ── SOCIAL PUBLISHING HUB ─────────────────────────────────────

# Meta (Facebook + Instagram) publishing
META_ACCESS_TOKEN=""
META_GRAPH_VERSION="v23.0"
META_PIXEL_ID=""
META_CLIENT_ID=""
META_CLIENT_SECRET=""

# TikTok Business API
TIKTOK_ACCESS_TOKEN=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""

# Snapchat Marketing API
SNAPCHAT_TOKEN=""
SNAPCHAT_ACCESS_TOKEN=""
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""

# Google Ads API
GOOGLE_ADS_ACCESS_TOKEN=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
GOOGLE_ADS_VERSION="v22"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Analytics 4
GA4_MEASUREMENT_ID=""
GA4_API_SECRET=""

# LinkedIn Marketing API
LINKEDIN_TOKEN=""
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_VERSION="202601"
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# 32+ character secret used only to encrypt advertising OAuth tokens
OAUTH_ENCRYPTION_KEY=""

# ── DRIZZLE ORM (for schema migrations) ───────────────────────

# Same as DATABASE_URL — used by drizzle-kit push/generate
# Direct connection for migrations (port 5432 is OK here)
DRIZZLE_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres"

# ══════════════════════════════════════════════════════════════
# QUICK START CHECKLIST
# ══════════════════════════════════════════════════════════════
# 1. Fill SUPABASE_URL, SUPABASE_SERVICE_KEY, DATABASE_URL (port 6543!)
# 2. Fill AUTH_SECRET (openssl rand -base64 32)
# 3. Fill NEXTAUTH_URL (http://localhost:3000 for local)
# 4. Run: npm install && npx tsx scripts/seed.ts
# 5. Run: npm run dev
# 6. Login at http://localhost:3000/login
# 7. Use quick-select role buttons — password is "password"
