# Vivit Group ERP isolated runtime — NEVER fall back to Marketing production credentials
VGROUP_DATABASE_URL="postgresql://..."
VGROUP_SUPABASE_URL="https://YOUR_GROUP_PROJECT.supabase.co"
VGROUP_SUPABASE_PUBLISHABLE_KEY=""
VGROUP_SUPABASE_SERVICE_KEY=""
VGROUP_AUTH_SECRET=""
VGROUP_NEXTAUTH_URL="http://localhost:3000/group"
VGROUP_STORAGE_SHARED_BUCKET="vgroup-shared"
VGROUP_STORAGE_HOSPITALITY_BUCKET="vgroup-hospitality"
VGROUP_STORAGE_TECH_BUCKET="vgroup-tech"
VGROUP_OAUTH_ENCRYPTION_KEY=""
VGROUP_CRON_SECRET=""
VGROUP_ENVIRONMENT="development"

# Unified Marketing integration remains fail-closed until the final certified cutover.
VGROUP_MARKETING_INTEGRATION_ENABLED="false"
# Exact Marketing/Vivito source integrated into the unified candidate.
VGROUP_MARKETING_CANDIDATE_SHA="9817ec42750b17104c5292eb2ec4d02358b53290"
# Dedicated cross-workspace HMAC secret. MUST differ from Group and Marketing auth secrets; use >=32 random bytes.
VGROUP_MARKETING_HANDOFF_SECRET=""
# In a one-production deployment this points to the same origin receiver path.
# Example: https://erp.example.com/api/integrations/vgroup-handoff
VGROUP_MARKETING_HANDOFF_URL=""
# Exact unified production browser origin, no trailing slash.
VGROUP_GROUP_ORIGIN=""
