# Use npm's modern peer dependency resolver so optional peers are not silently
# deduped to incompatible versions in the lockfile.
legacy-peer-deps=false

# Use semver ranges from package.json while keeping the lockfile deterministic.
save-exact=false

# Vercel production optimizations
prefer-dedupe=true

# CI installs must not submit an implicit registry audit.
# Security is enforced explicitly by npm audit --omit=dev --audit-level=high in the build gate.
audit=false
fund=false
